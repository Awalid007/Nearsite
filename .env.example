# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CEO App Dashboard & Webhook
# Nearsite CEO Dashboard: https://i-want-to-build-for-myself-only-which-is.rork.app/
# Connects bookings, contact messages, and quotes directly to your external app or CRM webhook.
VITE_APP_API_URL="https://i-want-to-build-for-myself-only-which-is.rork.app/"
VITE_APP_WEBHOOK_URL=""

# Automated Email Dispatch (Send confirmations directly from Nearsiteahmad@gmail.com)
# In Vercel Project Settings -> Environment Variables:
GMAIL_USER="Nearsiteahmad@gmail.com"
# 16-character Google App Password generated in your Google Account:
# Go to: https://myaccount.google.com/apppasswords -> Select App: Mail -> Copy 16-letter password
GMAIL_APP_PASSWORD=""


# Contact form (Web3Forms): free, emails each "free mockup" request to you.
# 1) Go to https://web3forms.com, enter the email where you want requests delivered.
# 2) Copy the access key they email you and add it in Vercel -> Settings -> Environment Variables
#    as VITE_WEB3FORMS_ACCESS_KEY (then redeploy). The key is safe to expose in the browser.
VITE_WEB3FORMS_ACCESS_KEY=""
